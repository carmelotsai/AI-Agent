# 複製這個檔案為 .env，填上真正的值。.env 不會進 Git。

# Google AI Studio 的 Gemini API Key：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# @BotFather 建立 Bot 後拿到的 Token
TELEGRAM_BOT_TOKEN=

# 你自己的 Telegram User ID（只填自己，逗號分隔可填多個）
# 取得方式見 README「取得白名單 ID」
TELEGRAM_ALLOWED_USERS=

# （選填，L3-4 查地圖用）SerpApi 金鑰：https://serpapi.com 註冊 Free Plan 後在 Dashboard 取得
# 沒填的話秘書照常上班，只是不會查地圖
SERPAPI_KEY=
